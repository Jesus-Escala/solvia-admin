# Base URL of the Solvia API. Keep "/api" to use the Vite dev proxy (and nginx in Docker).
VITE_API_URL=/api
# Where the Vite dev server proxies /api requests
VITE_PROXY_TARGET=http://localhost:4000
# ISO 4217 currency used to format amounts
VITE_CURRENCY=PEN
# URL of the business web app ("Open the app" link)
VITE_APP_URL=http://localhost:5173
